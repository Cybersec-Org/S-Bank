{
  "realm": "sbank",
  "enabled": true,
  "displayName": "S-Bank",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "LINEAR",
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["pl", "en"],
  "defaultLocale": "pl",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@sbank.localhost",
    "fromDisplayName": "S-Bank",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "REVOKE_GRANT",
    "REVOKE_GRANT_ERROR",
    "SEND_VERIFY_EMAIL",
    "SEND_VERIFY_EMAIL_ERROR",
    "VERIFY_EMAIL",
    "VERIFY_EMAIL_ERROR",
    "SEND_RESET_PASSWORD",
    "SEND_RESET_PASSWORD_ERROR",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "UPDATE_CREDENTIAL",
    "UPDATE_CREDENTIAL_ERROR",
    "REMOVE_CREDENTIAL",
    "REMOVE_CREDENTIAL_ERROR",
    "UPDATE_EMAIL",
    "UPDATE_EMAIL_ERROR",
    "UPDATE_PROFILE",
    "UPDATE_PROFILE_ERROR",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR",
    "DELETE_ACCOUNT",
    "DELETE_ACCOUNT_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Bank customer: own accounts, transfers and payees only"
      },
      {
        "name": "employee",
        "description": "Customer service employee: read-only customer view, account block and limit changes"
      },
      {
        "name": "admin",
        "description": "Bank administrator: roles, API partners, audit log, global parameters"
      },
      {
        "name": "uma_authorization",
        "description": "Keycloak built-in UMA role; declared here so it is not a default role (no UMA in S-Bank)"
      },
      {
        "name": "default-roles-sbank",
        "description": "Roles of every new user: customer, plus what Keycloak always adds on import",
        "composite": true,
        "composites": {
          "realm": ["customer", "offline_access"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-sbank",
    "description": "Roles of every new user: customer, plus what Keycloak always adds on import",
    "composite": true
  },
  "scopeMappings": [
    {
      "client": "sbank-app",
      "roles": ["customer", "employee", "admin"]
    }
  ],
  "clients": [
    {
      "clientId": "sbank-app",
      "name": "S-Bank",
      "description": "Public OIDC client of the S-Bank app (iOS, Android, web): Authorization Code + PKCE S256 only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "rootUrl": "https://localhost",
      "baseUrl": "/",
      "redirectUris": ["https://localhost/oauth/callback", "http://localhost:8081/oauth/callback"],
      "webOrigins": ["https://localhost", "http://localhost:8081"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/oauth/logged-out##http://localhost:8081/oauth/logged-out",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": ["basic", "acr", "roles", "web-origins", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-sbank-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sbank-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sbank-api",
      "name": "S-Bank API",
      "description": "Resource server: exists only as the access token audience; no flows, cannot authenticate",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-jwt",
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "use.jwks.url": "false"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "admin-cli",
      "name": "Admin CLI (disabled in this realm)",
      "description": "Replaces the built-in client, which allows the password grant with full scope; S-Bank is administered from the master realm",
      "enabled": false,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ]
}
