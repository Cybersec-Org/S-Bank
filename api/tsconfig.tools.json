{
  // Compiles src and scripts to build/tools for `openapi:generate`. tsx cannot run the app because
  // esbuild does not emit decorator metadata, which Nest's dependency injection relies on.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./build/tools",
    "rootDir": "."
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
