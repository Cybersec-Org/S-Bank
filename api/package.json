{
  "name": "@sbank/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run prisma:generate && nest start --watch",
    "build": "pnpm run prisma:generate && nest build",
    "start:prod": "node dist/main.js",
    "lint": "pnpm run prisma:generate && eslint . --max-warnings 0",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit",
    "test": "pnpm run prisma:generate && vitest run --config ./vitest.config.ts",
    "test:e2e": "pnpm run prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "openapi:generate": "pnpm run prisma:generate && tsc -p tsconfig.tools.json && node build/tools/scripts/generate-openapi.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "dotenv-expand": "13.0.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
