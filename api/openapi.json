{
  "components": {
    "schemas": {
      "MeResponseDto": {
        "properties": {
          "acr": {
            "description": "Authentication context class of the session: `2` after a passkey login.",
            "nullable": true,
            "type": "string"
          },
          "roles": {
            "description": "Roles from the verified token.",
            "items": { "enum": ["customer", "employee", "admin", "partner"], "type": "string" },
            "type": "array"
          },
          "subject": { "description": "Keycloak subject (`sub`) of the caller.", "type": "string" }
        },
        "required": ["subject", "roles", "acr"],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "detail": {
            "description": "Safe, human-readable explanation. Never internal details.",
            "type": "string"
          },
          "errors": {
            "description": "Validation failures (400): which request properties were rejected.",
            "items": { "type": "string" },
            "type": "array"
          },
          "maxAgeSeconds": {
            "description": "Step-up required (403): maximum age of the authentication, in seconds.",
            "example": 300,
            "type": "integer"
          },
          "requiredAcr": {
            "description": "Step-up required (403): authentication context class the token must carry.",
            "example": "2",
            "type": "string"
          },
          "status": { "description": "HTTP status code.", "example": 403, "type": "integer" },
          "title": {
            "description": "Short, fixed summary of the problem type.",
            "example": "Forbidden",
            "type": "string"
          },
          "traceId": {
            "description": "Request id (also in the `x-request-id` response header) for support and log lookup.",
            "example": "3f1c2a4e-8b0d-4d57-9a53-0f5f1f6f8f21",
            "type": "string"
          },
          "type": {
            "description": "Relative URI identifying the problem type.",
            "example": "/problems/forbidden",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "traceId"],
        "type": "object"
      }
    },
    "securitySchemes": { "bearer": { "bearerFormat": "JWT", "scheme": "bearer", "type": "http" } }
  },
  "info": {
    "contact": {},
    "description": "Demonstration banking API. Errors are RFC 9457 problem details.",
    "title": "S-Bank API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MeResponseDto" } }
            },
            "description": "The verified caller."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" }
              }
            },
            "description": "Missing, invalid or expired access token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" }
              }
            },
            "description": "Role not allowed, or step-up authentication required."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" }
              }
            },
            "description": "Too many requests."
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "Who the API thinks the caller is.",
        "tags": ["me"]
      }
    }
  },
  "servers": [{ "url": "/" }],
  "tags": []
}
