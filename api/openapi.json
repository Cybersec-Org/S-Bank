  "info": {
    "title": "S-Bank API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UpdateLimitDto": {
        "type": "object",
        "properties": {
          "newLimit": {
            "type": "number",
            "example": 2000,
            "description": "New daily limit"
          }
        },
        "required": [
          "newLimit"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "FROZEN",
            "enum": [
              "ACTIVE",
              "FROZEN",
              "CLOSED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "senderAccountId": {
            "type": "string",
            "example": "uuid-sender-account",
            "description": "Sender Account ID (optional, defaults to primary PLN account)"
          },
          "receiverIban": {
            "type": "string",
            "example": "PL99102010260000140202736451",
            "description": "Receiver IBAN"
          },
          "receiverName": {
            "type": "string",
            "example": "Anna Nowak",
            "description": "Receiver Name"
          },
          "amount": {
            "type": "number",
            "example": 150.5,
            "description": "Amount to transfer"
          },
          "title": {
            "type": "string",
            "example": "Dinner payment",
            "description": "Transaction title"
          }
        },
        "required": [
          "senderAccountId",
          "receiverIban",
          "receiverName",
          "amount",
          "title"
        ]
      }
    }
  }
}