  "info": {
    "title": "S-Bank API",
    "description": "",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateSystemConfigDto": {
        "type": "object",
        "properties": {
          "stepUpThreshold": {
            "type": "number",
            "example": 1000,
            "description": "Minimum transfer amount requiring Passkey step-up (PLN)"
          },
          "minDailyLimit": {
            "type": "number",
            "example": 100,
            "description": "Minimum allowed daily limit (PLN)"
          },
          "maxDailyLimit": {
            "type": "number",
            "example": 50000,
            "description": "Maximum allowed daily limit (PLN)"
          }
        }
      },
      "UpdateLimitDto": {
        "type": "object",
        "properties": {
          "newLimit": {
            "type": "number",
            "example": 5000,
            "description": "New daily limit in allowed range (100 - 50 000 PLN)"
          }
        },
        "required": [
          "newLimit"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "FROZEN",
            "enum": [
              "ACTIVE",
              "FROZEN",
              "CLOSED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "senderAccountId": {
            "type": "string",
            "example": "uuid-sender-account",
            "description": "Sender Account ID (optional, defaults to primary PLN account)"
          },
          "receiverIban": {
            "type": "string",
            "example": "PL99102010260000140202736451",
            "description": "Receiver IBAN (PL + 26 digits)"
          },
          "receiverName": {
            "type": "string",
            "example": "Anna Nowak",
            "description": "Receiver Name"
          },
          "amount": {
            "type": "number",
            "example": 150.5,
            "description": "Amount to transfer (max 2 decimal places)"
          },
          "title": {
            "type": "string",
            "example": "Dinner payment",
            "description": "Transaction title"
          }
        },
        "required": [
          "receiverIban",
          "receiverName",
          "amount",
          "title"
        ]
      },
      "CreateRecipientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Anna Nowak (Czynsz)",
            "description": "Saved recipient display name"
          },
          "iban": {
            "type": "string",
            "example": "PL99102010260000140202736451",
            "description": "Recipient Polish IBAN"
          }
        },
        "required": [
          "name",
          "iban"
        ]
      },
      "CreatePaymentRequestDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "example": 149.99,
            "description": "Requested payment amount"
          },
          "title": {
            "type": "string",
            "example": "Zamówienie #1024 w sklepie Partner",
            "description": "Payment title"
          },
          "receiverIban": {
            "type": "string",
            "example": "PL99102010260000140202736451"
          },
          "receiverName": {
            "type": "string",
            "example": "Sklep Partner Sp. z o.o."
          }
        },
        "required": [
          "amount",
          "title"
        ]
      }
    }
  }
}