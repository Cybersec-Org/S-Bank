// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String      @id
  firstName      String
  lastName       String
  email          String      @unique
  customerNumber String      @unique
  accounts       Account[]
  recipients     Recipient[]
  createdAt      DateTime    @default(now())
}

model Account {
  id                   String        @id @default(uuid())
  iban                 String        @unique
  ownerId              String
  owner                Customer      @relation(fields: [ownerId], references: [id])
  currency             String        @default("PLN")
  balance              Decimal       @default(0.00)
  dailyLimit           Decimal       @default(5000.00)
  status               String        @default("ACTIVE")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  outgoingTransactions Transaction[] @relation("SenderAccount")
  incomingTransactions Transaction[] @relation("ReceiverAccount")
}

model Transaction {
  id                String    @id @default(uuid())
  operationNumber   String?   @unique
  senderAccountId   String
  receiverAccountId String?
  receiverIban      String
  receiverName      String
  amount            Decimal
  currency          String    @default("PLN")
  title             String
  status            String    @default("DRAFT")
  signature         String?
  createdAt         DateTime  @default(now())
  executedAt        DateTime?

  senderAccount   Account  @relation("SenderAccount", fields: [senderAccountId], references: [id])
  receiverAccount Account? @relation("ReceiverAccount", fields: [receiverAccountId], references: [id])
}

model Recipient {
  id        String   @id @default(uuid())
  ownerId   String
  owner     Customer @relation(fields: [ownerId], references: [id])
  name      String
  iban      String
  createdAt DateTime @default(now())
}

model PaymentRequest {
  id            String    @id @default(uuid())
  partnerId     String
  receiverIban  String
  receiverName  String
  amount        Decimal
  currency      String    @default("PLN")
  title         String
  status        String    @default("PENDING")
  transactionId String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model SystemConfig {
  id              String   @id @default("global")
  stepUpThreshold Decimal  @default(1000.00)
  minDailyLimit   Decimal  @default(100.00)
  maxDailyLimit   Decimal  @default(50000.00)
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   String
  action     String
  resourceId String?
  ipAddress  String?
  reason     String
  createdAt  DateTime @default(now())
}