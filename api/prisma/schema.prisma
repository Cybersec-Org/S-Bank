// Core schema (accounts and history, SR-05, SR-07, SR-14). The `init_core` migration adds what Prisma
// cannot express: CHECK constraints, the audit_log immutability trigger, least-privilege grants.
// Money is BigInt grosze (never floats). Primary keys are UUIDs generated by the database.
// `updated_at` also has a database default so raw SQL inserts do not have to supply it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  BLOCKED

  @@map("account_status")
}

enum TransactionDirection {
  DEBIT
  CREDIT

  @@map("transaction_direction")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Keycloak `sub` claim of the customer.
  subject     String   @unique
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts Account[]

  @@map("customers")
}

model Account {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  /// Normalized IBAN: uppercase, no spaces.
  iban             String        @unique @db.VarChar(34)
  currency         String        @default("PLN") @db.Char(3)
  balanceGrosze    BigInt        @map("balance_grosze")
  dailyLimitGrosze BigInt        @default(500000) @map("daily_limit_grosze")
  status           AccountStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        Customer      @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions Transaction[]

  @@index([ownerId])
  @@map("accounts")
}

model Transaction {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  direction        TransactionDirection
  amountGrosze     BigInt               @map("amount_grosze")
  counterpartyIban String               @map("counterparty_iban") @db.VarChar(34)
  counterpartyName String               @map("counterparty_name")
  title            String
  bookedAt         DateTime             @map("booked_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, bookedAt(sort: Desc)])
  @@map("transactions")
}

/// Append-only (SR-14): the application role gets INSERT only and a trigger rejects UPDATE/DELETE.
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Keycloak `sub` of the actor, or `anonymous` for events without an authenticated user.
  actorId      String   @map("actor_id")
  actorRole    String   @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ip           String?  @db.VarChar(45)
  acr          String?
  /// Never tokens, passwords or full card data.
  metadata     Json     @default("{}")

  @@index([occurredAt(sort: Desc)])
  @@map("audit_log")
}
