// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String    @id // np. 'client-1'
  firstName      String
  lastName       String
  email          String    @unique
  customerNumber String    @unique
  accounts       Account[]
  createdAt      DateTime  @default(now())
}

model Account {
  id                   String        @id @default(uuid())
  iban                 String        @unique
  ownerId              String
  owner                Customer      @relation(fields: [ownerId], references: [id])
  currency             String        @default("PLN")
  balance              Decimal       @default(0.00)
  dailyLimit           Decimal       @default(1000.00)
  status               String        @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  outgoingTransactions Transaction[] @relation("SenderAccount")
  incomingTransactions Transaction[] @relation("ReceiverAccount")
}

model Transaction {
  id                String    @id @default(uuid())
  operationNumber   String?   @unique // Zwracane po zatwierdzeniu (confirm)
  senderAccountId   String
  receiverAccountId String?
  receiverIban      String
  receiverName      String
  amount            Decimal
  currency          String    @default("PLN")
  title             String
  status            String    @default("DRAFT") // DRAFT, COMPLETED, CANCELLED
  createdAt         DateTime  @default(now())
  executedAt        DateTime? 

  senderAccount   Account  @relation("SenderAccount", fields: [senderAccountId], references: [id])
  receiverAccount Account? @relation("ReceiverAccount", fields: [receiverAccountId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   String
  action     String
  resourceId String?
  ipAddress  String?
  reason     String
  createdAt  DateTime @default(now())
}