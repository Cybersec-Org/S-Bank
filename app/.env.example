# Copy to app/.env and fill in. Only EXPO_PUBLIC_* values reach the app bundle, so never put secrets here.

# mock   – demo data in memory (default outside production builds)
# hybrid – development only: accounts, history, transfers, rates and the employee panel use the dev API
#          from api/ (identity sent in x-user-id / x-user-role headers); everything else stays on demo data
# live   – the real API with real sign-in (not available yet)
EXPO_PUBLIC_API_MODE=hybrid

# Dev API address. In a browser on this computer: http://127.0.0.1:3000
# On a phone (Expo Go): http://<this computer's LAN IP>:3000 and start the API with HOST=0.0.0.0
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

EXPO_PUBLIC_OIDC_ISSUER_URL=https://localhost/auth/realms/sbank
EXPO_PUBLIC_OIDC_CLIENT_ID=sbank-app
