# Copy to app/.env and fill in. Only EXPO_PUBLIC_* values reach the app bundle, so never put secrets here.

# mock   – demo data in memory, demo sign-in (default outside production builds)
# hybrid – development only: accounts, history, transfers, rates and the employee panel use an API started with
#          AUTH_MODE=mock (identity sent in x-user-id / x-user-role headers). The API from docker-compose.yml runs
#          with AUTH_MODE=oidc and rejects these headers.
# live   – the API from docker-compose.yml with real sign-in through Keycloak (OIDC + PKCE)
EXPO_PUBLIC_API_MODE=live

# API from docker-compose.yml (published on 127.0.0.1:3000).
# Web on this computer: http://localhost:3000 (the API allows CORS from http://localhost:8081).
# Android emulator / phone (development build): the same address after `adb reverse tcp:3000 tcp:3000`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Keycloak issuer. Must be exactly the `iss` of the tokens (KC_HOSTNAME in docker-compose.yml).
# Android: `adb reverse tcp:8080 tcp:8080`, so the phone also uses localhost and the passkey RP ID matches.
EXPO_PUBLIC_OIDC_ISSUER_URL=http://localhost:8080/realms/sbank
EXPO_PUBLIC_OIDC_CLIENT_ID=sbank-app

# Production builds require https:// for both URLs (src/shared/config/env.ts).
