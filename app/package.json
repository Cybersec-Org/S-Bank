{
  "name": "@sbank/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "expo export --platform web --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native",
    "doctor": "expo-doctor",
    "build:android": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug --no-daemon",
    "api:types": "openapi-typescript ../api/openapi.json -o src/shared/api/schema.d.ts && pnpm exec prettier --write src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.104.1",
    "expo": "~57.0.30",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "57.0.3",
    "expo-router": "~57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.21.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "openapi-typescript": "7.13.0",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
