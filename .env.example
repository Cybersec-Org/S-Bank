# Copy to .env (repository root, never committed) and fill in. `pnpm secrets:dev` replaces every CHANGE_ME of
# POSTGRES_PASSWORD, KEYCLOAK_ADMIN_PASSWORD and PARTNER_PROXY_TOKEN with a random value and keeps real values.
# docker-compose.yml reads this file; the API started on the host (`pnpm api:dev`) reads it too (../.env).
# Setup, test accounts and temporary passwords: docs/auth/06-konta-testowe.md.

# --- docker-compose.yml: database ----------------------------------------------------------------------------
POSTGRES_USER=sbank
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sbank

# --- docker-compose.yml: Keycloak bootstrap administrator (realm master) ------------------------------------
# Also used by the API for /auth/passkeys (open item A5: replace with a service account in realm sbank).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- docker-compose.yml: partner API behind Caddy (mTLS) ------------------------------------------------------
# Shared secret Caddy adds to partner requests; the API accepts partner headers only with it.
PARTNER_PROXY_TOKEN=CHANGE_ME
# SHA-256 of each partner's client certificate (DER), lowercase hex, no colons. Must match Caddy/Caddyfile:
#   openssl x509 -in certs/partners/partner1.crt -outform DER | sha256sum | cut -d' ' -f1
PARTNER1_CERT_SHA256=CHANGE_ME
PARTNER2_CERT_SHA256=CHANGE_ME

# --- API started on the host (`pnpm api:dev`) instead of the container -----------------------------------------
# docker-compose.yml sets these for the container itself; uncomment only for a host run (stop the `api` container
# first, it holds 127.0.0.1:3000).
# DATABASE_URL=postgresql://sbank:CHANGE_ME@127.0.0.1:5432/sbank
# PORT=3000
# NODE_ENV=development
# AUTH_MODE=oidc                     # oidc = Keycloak tokens; mock = x-user-* headers (refused when NODE_ENV=production)
# OIDC_ISSUER_URL=http://localhost:8080/realms/sbank
# OIDC_JWKS_URL=                     # optional; default ${OIDC_ISSUER_URL}/protocol/openid-connect/certs
# OIDC_AUDIENCE=sbank-api
# OIDC_CLIENT_ID=sbank-app
# KEYCLOAK_ADMIN_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:8081  # comma-separated; outside production the default is localhost:8081 and 127.0.0.1:8081
# STRICT_AUTH=false                  # mock mode: true = no default identity without x-user-* headers
# KEYCLOAK_JWKS_URI= KEYCLOAK_ISSUER= KEYCLOAK_AUDIENCE=   # mock mode only: verify Bearer tokens if present
# PKCS11_MODULE_PATH=                # SoftHSM2 module for signing transfer confirmations (not set = software key)
