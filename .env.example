# Szablon konfiguracji lokalnej S-Bank. Zawiera wyłącznie wartości przykładowe i znaczniki.
# Prawdziwe wartości trafiają do pliku .env, który tworzy `node scripts/dev-secrets.mjs`
# (każde __GENERATE__ zamienia się w losowy sekret). Pliku .env NIGDY nie commitujemy.
#
# Wartości ${NAZWA} są rozwijane przez Docker Compose i przez ładowanie konfiguracji w API.

# --- Docker Compose (infra/docker-compose.yml) ---
# Ten blok jest pierwszy, bo Compose rozwija ${NAZWA} tylko do zmiennych zdefiniowanych wcześniej w pliku.
SBANK_DOMAIN=localhost
# Superużytkownik bazy aplikacji (administracja); API nigdy się nim nie łączy.
POSTGRES_PASSWORD=__GENERATE__
# Role z infra/postgres/init/01-roles.sql; hasła są ustawiane tylko przy pierwszym starcie pustej bazy.
POSTGRES_MIGRATOR_PASSWORD=__GENERATE__
POSTGRES_APP_PASSWORD=__GENERATE__
# Baza Keycloak (użytkownik keycloak).
KC_DB_PASSWORD=__GENERATE__
# Tymczasowe konto administratora Keycloak (konsola tylko przez profil dev-ports, patrz infra/README.md).
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__

# --- API (api/src/config/env.schema.ts) ---
NODE_ENV=development
API_PORT=3000
# Rola sbank_app: tylko DML, bez zmian w dzienniku audytowym (infra/postgres/init).
DATABASE_URL=postgresql://sbank_app:${POSTGRES_APP_PASSWORD}@localhost:5432/sbank
CORS_ORIGINS=http://localhost:8081
OIDC_ISSUER_URL=https://localhost/auth/realms/sbank
OIDC_AUDIENCE=sbank-api
# Puste = adres kluczy z dokumentu discovery wystawcy.
OIDC_JWKS_URL=
LOG_LEVEL=info
STEP_UP_THRESHOLD_GROSZE=100000
DEFAULT_DAILY_LIMIT_GROSZE=500000
NBP_API_BASE_URL=https://api.nbp.pl/api
# true tylko za Caddy (w Docker Compose jest ustawiane w usłudze api).
TRUST_PROXY=false

# --- Aplikacja (app/src/shared/config/env.ts); wartości jawne, trafiają do paczki ---
# mock = dane demonstracyjne bez API, live = prawdziwe API
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=https://localhost
EXPO_PUBLIC_OIDC_ISSUER_URL=https://localhost/auth/realms/sbank
EXPO_PUBLIC_OIDC_CLIENT_ID=sbank-app
