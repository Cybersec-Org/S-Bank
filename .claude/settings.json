{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm install --frozen-lockfile *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm why *)",
      "Bash(pnpm list *)",
      "Bash(pnpm ls *)",
      "Bash(pnpm view *)",
      "Bash(pnpm --version)",
      "Bash(node --version)",
      "Bash(node scripts/dev-secrets.mjs *)",
      "Bash(docker --version)",
      "Bash(docker compose version *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:www.keycloak.org)",
      "WebFetch(domain:caddyserver.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:typescript-eslint.io)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:jestjs.io)",
      "WebFetch(domain:callstack.github.io)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:casl.js.org)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:mas.owasp.org)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:semgrep.dev)",
      "WebFetch(domain:trivy.dev)",
      "WebFetch(domain:www.zaproxy.org)",
      "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:www.rfc-editor.org)",
      "WebFetch(domain:api.nbp.pl)",
      "WebFetch(domain:www.npmjs.com)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm create *)",
      "Bash(npx *)",
      "Bash(npm install *)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(pnpm run api:db:reset *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git notes *)",
      "Bash(git init *)",
      "Bash(git update-ref *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh workflow run *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm exec prisma db push *)",
      "Bash(npx prisma db push *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(!*.pub)",
      "Read(infra/secrets/**)",
      "Read(infra/softhsm/tokens/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"],
            "timeout": 10,
            "statusMessage": "Checking command against repository policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs"],
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ]
  }
}
